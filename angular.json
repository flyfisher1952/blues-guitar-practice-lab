{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "blues-guitar-practice-lab": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": []
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {"type": "initial", "maximumWarning": "800kB", "maximumError": "1MB"},
                {"type": "anyComponentStyle", "maximumWarning": "20kB", "maximumError": "30kB"}
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": {"buildTarget": "blues-guitar-practice-lab:build:production"},
            "development": {"buildTarget": "blues-guitar-practice-lab:build:development"}
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
